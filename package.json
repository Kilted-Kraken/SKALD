{
  "name": "skald-launcher",
  "version": "0.1.0",
  "description": "SKALD ROM Launcher — archive.org powered retro gaming library",
  "author": "Kilted-Kraken",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "howlongtobeat-core": "^1.1.1",
    "stoat.js": "^7.3.6"
  },
  "build": {
    "appId": "com.skald.launcher",
    "productName": "SKALD Launcher",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/roms"
    ],
    "extraResources": [
      {
        "from": "assets/roms",
        "to": "roms"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/rg-logo.ico"
    },
    "mac": {
      "icon": "assets/icons/rg-logo.icns"
    },
    "linux": {
      "icon": "assets/icons/rg-logo.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Kilted-Kraken",
      "repo": "SKALD"
    }
  }
}
