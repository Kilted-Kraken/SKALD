{
  "name": "skald-launcher",
  "version": "0.1.1-beta.8",
  "description": "SKALD ROM Launcher — archive.org powered retro gaming library",
  "author": "Kilted-Kraken",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "report:pack": "node scripts/report-marketplace-pack.js",
    "report:pack:quality": "node scripts/report-marketplace-pack-quality.js",
    "report:pack:candidates": "node scripts/build-marketplace-pack-candidates.js",
    "create:pack:batch": "node scripts/create-marketplace-pack-batch.js",
    "create:pack:quality-batch": "node scripts/create-marketplace-pack-quality-batch.js",
    "fetch:pack:screenscraper": "node scripts/fetch-screenscraper-pack-batch.js",
    "validate:pack:batch": "node scripts/validate-marketplace-pack-batch.js",
    "validate:pack": "node scripts/validate-marketplace-pack.js",
    "merge:pack": "node scripts/merge-marketplace-pack-batch.js",
    "organize:gamerpics": "node scripts/organize-gamerpics-for-archive.js"
  },
  "devDependencies": {
    "electron": "40.8.5",
    "electron-builder": "latest"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "howlongtobeat-core": "^1.1.1",
    "sharp": "^0.34.5",
    "stoat.js": "^7.3.6"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.12",
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1",
    "picomatch": "4.0.4",
    "tar": "7.5.13",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.0.3"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.0.3"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.5"
    }
  },
  "build": {
    "appId": "com.skald.launcher",
    "productName": "SKALD Launcher",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!src/native/**/bin{,/**/*}",
      "!src/native/**/obj{,/**/*}",
      "!src/renderer/blades.system-backup.html",
      "!assets/tools/7zip/**/*",
      "!assets/roms",
      "!assets/themes/RG-THEMES/X360 Blades Reference{,/**/*}",
      "!assets/themes/RG-THEMES/Archive Ready{,/**/*}",
      "!assets/themes/RG-THEMES/GamerPics{,/**/*}",
      "!assets/themes/RG-THEMES/1-Home Screen-MOCKUP.afphoto",
      "!assets/themes/RG-THEMES/My Picture Pack",
      "!assets/themes/RG-THEMES/XBMC360.7z",
      "!assets/themes/RG-THEMES/**/*.7z",
      "!assets/themes/RG-THEMES/**/*.afphoto"
    ],
    "extraResources": [
      {
        "from": "assets/tools/7zip",
        "to": "tools/7zip"
      },
      {
        "from": "src/native/Skald.VlcHost/bin/Release/net10.0-windows/win-x64/publish",
        "to": "tools/Skald.VlcHost"
      },
      {
        "from": "src/native/Skald.Rpcs3Helper/bin/Release/net10.0-windows/win-x64/publish",
        "to": "tools/Skald.Rpcs3Helper"
      },
      {
        "from": "src/native/Skald.GuideWatcher/bin/Release/net10.0-windows/win-x64/publish",
        "to": "tools/Skald.GuideWatcher"
      },
      {
        "from": "assets/roms",
        "to": "roms"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/rg-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "icon": "assets/icons/rg-logo.icns"
    },
    "linux": {
      "icon": "assets/icons/rg-logo.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Kilted-Kraken",
      "repo": "SKALD"
    }
  }
}
