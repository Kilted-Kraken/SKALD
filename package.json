{
  "name": "skald-launcher",
  "version": "0.1.1-beta.1",
  "description": "SKALD ROM Launcher — archive.org powered retro gaming library",
  "author": "Kilted-Kraken",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "report:pack": "node scripts/report-marketplace-pack.js",
    "report:pack:quality": "node scripts/report-marketplace-pack-quality.js",
    "report:pack:candidates": "node scripts/build-marketplace-pack-candidates.js",
    "create:pack:batch": "node scripts/create-marketplace-pack-batch.js",
    "create:pack:quality-batch": "node scripts/create-marketplace-pack-quality-batch.js",
    "fetch:pack:screenscraper": "node scripts/fetch-screenscraper-pack-batch.js",
    "report:minerva:torrent": "node scripts/report-minerva-torrent.js",
    "build:minerva:index": "node scripts/build-minerva-index.js",
    "prototype:minerva:download": "node scripts/prototype-minerva-download.mjs",
    "validate:pack:batch": "node scripts/validate-marketplace-pack-batch.js",
    "validate:pack": "node scripts/validate-marketplace-pack.js",
    "merge:pack": "node scripts/merge-marketplace-pack-batch.js"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "howlongtobeat-core": "^1.1.1",
    "sharp": "^0.34.5",
    "stoat.js": "^7.3.6",
    "webtorrent": "^2.8.5"
  },
  "build": {
    "appId": "com.skald.launcher",
    "productName": "SKALD Launcher",
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/tools/7zip/**/*",
      "!assets/roms"
    ],
    "extraResources": [
      {
        "from": "assets/tools/7zip",
        "to": "tools/7zip"
      },
      {
        "from": "src/native/Skald.VlcHost/bin/Release/net10.0-windows/win-x64/publish",
        "to": "tools/Skald.VlcHost"
      },
      {
        "from": "src/native/Skald.Rpcs3Helper/bin/Release/net10.0-windows/win-x64/publish",
        "to": "tools/Skald.Rpcs3Helper"
      },
      {
        "from": "assets/roms",
        "to": "roms"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/rg-logo.ico"
    },
    "mac": {
      "icon": "assets/icons/rg-logo.icns"
    },
    "linux": {
      "icon": "assets/icons/rg-logo.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Kilted-Kraken",
      "repo": "SKALD"
    }
  }
}
